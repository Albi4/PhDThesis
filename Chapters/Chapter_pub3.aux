\@writefile{lof}{\contentsline {figure}{\numberline {6.6}{\ignorespaces Frequency and damping rate of the Dy crossover mode on resonance ($x=0$) as a function of the atom number ratio. With increasing $N_{\textrm  Dy}/N_{\textrm  K}$, the temperature decreases from 170 to \SI {130}{nK}. The bullet symbols represent the experimental data with 1$\sigma $ uncertainties. The solid curves show the theoretical behavior according to our model (see text). The shaded regions represent the effect of $\pm 10\%$ atom number uncertainties.\relax }}{70}{figure.caption.32}\protected@file@percent }
\newlabel{fig:FreqAndDampingwithNr}{{6.6}{70}{Frequency and damping rate of the Dy crossover mode on resonance ($x=0$) as a function of the atom number ratio. With increasing $N_{\textrm Dy}/N_{\textrm K}$, the temperature decreases from 170 to \SI {130}{nK}. The bullet symbols represent the experimental data with 1$\sigma $ uncertainties. The solid curves show the theoretical behavior according to our model (see text). The shaded regions represent the effect of $\pm 10\%$ atom number uncertainties.\relax }{figure.caption.32}{}}
