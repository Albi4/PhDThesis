\@writefile{lof}{\contentsline {figure}{\numberline {6.11}{\ignorespaces Species overlap in the mixture. (a) Spatial profiles for typical experimental conditions $N_{\textrm  Dy} = 5\times 10^4$, $N_{\textrm  K} = 2\times 10^4$, $T = \SI {100}{nK}$ in a spherically symmetric trap with mean frequencies $\bar  {\omega }_{\textrm  Dy}/2\pi = \SI {37}{Hz}$ and $\bar  {\omega }_{\textrm  K}/2\pi = \SI {112}{Hz}$. The reduced temperatures $T_{\textrm  Dy}/T_F^{\textrm  Dy} = 0.84$ and $T_{\textrm  K}/T_F^{\textrm  K} = 0.38$ correspond to moderate Fermi degeneracy. (b)~Overlap integral $n_\Omega $ as a function of a spatial displacement between the cloud centers (solid line) with a second-order Taylor expansion (dotted line). \relax }}{84}{figure.caption.37}\protected@file@percent }
\newlabel{fig:overlap}{{6.11}{84}{Species overlap in the mixture. (a) Spatial profiles for typical experimental conditions $N_{\textrm Dy} = 5\times 10^4$, $N_{\textrm K} = 2\times 10^4$, $T = \SI {100}{nK}$ in a spherically symmetric trap with mean frequencies $\bar {\omega }_{\textrm Dy}/2\pi = \SI {37}{Hz}$ and $\bar {\omega }_{\textrm K}/2\pi = \SI {112}{Hz}$. The reduced temperatures $T_{\textrm Dy}/T_F^{\textrm Dy} = 0.84$ and $T_{\textrm K}/T_F^{\textrm K} = 0.38$ correspond to moderate Fermi degeneracy. (b)~Overlap integral $n_\Omega $ as a function of a spatial displacement between the cloud centers (solid line) with a second-order Taylor expansion (dotted line). \relax }{figure.caption.37}{}}
