\@writefile{lof}{\contentsline {figure}{\numberline {6.8}{\ignorespaces Slow damping mode on resonance for $N_{\textrm  Dy}/N_{\textrm  K}=4.5$. (a) Temporal evolution of the COM positions of the Dy (blue) and K (orange) clouds in the ODT. The solid curves are the fits based on our theoretical model and procedures outlined in Sec.~\ref {ssec:fitting} ($t_{\textrm  TOF}=0$ for {\textit  in-situ} imaging). (b) Difference between COM positions for the Dy and K clouds. The red solid curve corresponds to the full theoretical model with all three modes, and the gray solid curve shows the contribution of the slow damping mode. The blue symbols represent the experimental data point with standard errors obtained from five repetitions per point. The shaded region around the fit curves indicates the 95\% confidence band.\relax }}{73}{figure.caption.34}\protected@file@percent }
\newlabel{fig:SLowModeDemo}{{6.8}{73}{Slow damping mode on resonance for $N_{\textrm Dy}/N_{\textrm K}=4.5$. (a) Temporal evolution of the COM positions of the Dy (blue) and K (orange) clouds in the ODT. The solid curves are the fits based on our theoretical model and procedures outlined in Sec.~\ref {ssec:fitting} ($t_{\textrm TOF}=0$ for {\textit in-situ} imaging). (b) Difference between COM positions for the Dy and K clouds. The red solid curve corresponds to the full theoretical model with all three modes, and the gray solid curve shows the contribution of the slow damping mode. The blue symbols represent the experimental data point with standard errors obtained from five repetitions per point. The shaded region around the fit curves indicates the 95\% confidence band.\relax }{figure.caption.34}{}}
\mph@setcol{ii:73}{\mph@nr}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {6.4.3.3}{Resonance crossover}}{74}{subsubsection.6.4.3.3}\protected@file@percent }
\mph@setcol{ii:74}{\mph@nr}
\@writefile{lof}{\contentsline {figure}{\numberline {6.9}{\ignorespaces Damping rates of all dipole modes across the resonance. The symbols represent the experimental measurements and the solid lines show the result of a combined fit to the data. While, close to resonance, the Dy crossover mode (blue triangles) makes a smooth transition into the hydrodynamic regime, the K mode (red squares) loses its oscillatory character and splits into two exponentially damped modes (circular symbols). All measurements have been taken with time-of-flight imaging, with the exception of the single data point for the slow mode (labeled `slow 2' ), for which we have applied {\textit  in situ} imaging.\relax }}{75}{figure.caption.35}\protected@file@percent }
\newlabel{fig:FastAndSlowMode}{{6.9}{75}{Damping rates of all dipole modes across the resonance. The symbols represent the experimental measurements and the solid lines show the result of a combined fit to the data. While, close to resonance, the Dy crossover mode (blue triangles) makes a smooth transition into the hydrodynamic regime, the K mode (red squares) loses its oscillatory character and splits into two exponentially damped modes (circular symbols). All measurements have been taken with time-of-flight imaging, with the exception of the single data point for the slow mode (labeled `slow 2' ), for which we have applied {\textit in situ} imaging.\relax }{figure.caption.35}{}}
